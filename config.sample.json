{
    "default_provider": "gpt-image",
    "providers": {
        "gpt-image": {
            "endpoints": [
                {
                    "base_url": "YOUR_KMAGE_OR_PROXY_BASE_URL_1",
                    "api_key": "YOUR_API_KEY_1"
                },
                {
                    "base_url": "YOUR_KMAGE_OR_PROXY_BASE_URL_2",
                    "api_key": "YOUR_API_KEY_2"
                }
            ],
            "model": "gpt-image-2",
            "endpoint_type": "openai_compatible"
        },
        "qwen-image": {
            "api_key": "YOUR_API_KEY",
            "base_url": "YOUR_BASE_URL",
            "model": "Qwen/Qwen-Image",
            "endpoint_type": "openai_compatible"
        },
        "qwen-image-flash": {
            "api_key": "YOUR_API_KEY",
            "base_url": "YOUR_BASE_URL",
            "model": "qwen-image-flash",
            "endpoint_type": "openai_compatible"
        },
        "minimax-image": {
            "api_key": "YOUR_API_KEY",
            "base_url": "https://api.minimaxi.com/v1",
            "model": "image-01",
            "endpoint_type": "minimax"
        },
        "kwai-image": {
            "api_key": "YOUR_API_KEY",
            "base_url": "YOUR_BASE_URL",
            "model": "Kwai-Kolors/Kolors",
            "endpoint_type": "openai_compatible"
        }
    },
    "fallback_order": ["gpt-image", "qwen-image", "minimax-image", "kwai-image", "qwen-image-flash"],
    "default_size": "1024x1024",
    "default_quality": "high",
    "default_response_format": "b64_json",
    "supported_sizes": [
        "1024x1024",
        "1536x1024",
        "1024x1536",
        "1536x864",
        "864x1536",
        "1536x1152",
        "1152x1536",
        "2048x2048",
        "4096x4096"
    ],
    "supported_ratios": {
        "1:1": "1024x1024",
        "16:9": "1536x864",
        "9:16": "864x1536",
        "4:3": "1536x1152",
        "3:4": "1152x1536",
        "3:2": "1536x1024",
        "2:3": "1024x1536"
    },
    "timeout": 180,
    "max_retries": 3
}
